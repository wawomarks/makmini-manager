#!/system/bin/sh
# =============================================================================
#  glm -- GhostLock Root Manager  (KernelSU-Next-style, userspace)
#
#  Enforcement lives in the patched su client: it reads /odm/ghostlock/policy.bin
#  (a little-endian u32 list of allowed uids) and refuses uid 0 / 2000 / listed.
#  This CLI edits the policy list, re-applies it through the root helper, shows
#  the audit log, and maps uids to package names.
# =============================================================================
VERSION=1.0
D=/data/local/tmp/.gl
M=$D/manager
CONF=$M/policy.conf
BIN=$M/policy.bin
MAP=$M/uids.map
REQ=$M/req
ST=/odm/ghostlock/status
ALOG=/odm/ghostlock/su.log
SU=/odm/bin/su
PWN=$D/pwn2

die() { echo "glm: $*" >&2; exit 1; }

# ---- run as the shell user ------------------------------------------------
# The store is owned by uid 2000 (that is the uid the boot hook and adb use).
# Termux runs as u0_aNNN, so management commands are re-run through the
# phone's own adbd (127.0.0.1:5555), which authenticates as uid 2000.
proxy() {
  ADB=""
  for c in "${PREFIX:-/data/data/com.termux/files/usr}/bin/adb" adb; do
    if command -v "$c" >/dev/null 2>&1; then ADB="$c"; break; fi
  done
  [ -n "$ADB" ] || die "management needs uid 2000; run this from 'adb shell'"
  export ANDROID_ADB_SERVER_PORT="${ANDROID_ADB_SERVER_PORT:-5038}"
  if ! "$ADB" get-state >/dev/null 2>&1; then
    "$ADB" connect 127.0.0.1:5555 >/dev/null 2>&1
    "$ADB" get-state >/dev/null 2>&1 || {
      "$ADB" kill-server >/dev/null 2>&1
      "$ADB" start-server >/dev/null 2>&1
      "$ADB" connect 127.0.0.1:5555 >/dev/null 2>&1
    }
  fi
  line="sh $M/glm"
  for a in "$@"; do
    e=$(printf '%s' "$a" | sed 's/[\\"$`]/\\&/g')
    line="$line \"$e\""
  done
  exec "$ADB" -s 127.0.0.1:5555 shell "$line"
}

need_store() {
  [ -d "$M" ] || mkdir -p "$M" 2>/dev/null
  [ -d "$M" ] || die "cannot create $M"
  [ -f "$CONF" ] || : > "$CONF"
  [ -f "$REQ" ]  || : > "$REQ"
  [ -f "$D/rw.list" ] || : > "$D/rw.list"
}

map_refresh() {
  mkdir -p "$M" 2>/dev/null
  pm list packages -U 2>/dev/null \
    | sed -n 's/^package:\([^ ]*\).* uid:\([0-9][0-9]*\).*/\2 \1/p' > "$MAP.tmp" 2>/dev/null
  if [ -s "$MAP.tmp" ]; then mv "$MAP.tmp" "$MAP"; else rm -f "$MAP.tmp"; fi
}

uid_of() {
  case "$1" in
    ''|*[!0-9]*)
      [ -f "$MAP" ] || map_refresh
      u=$(grep -m1 " $1\$" "$MAP" 2>/dev/null | cut -d' ' -f1)
      if [ -z "$u" ]; then map_refresh; u=$(grep -m1 " $1\$" "$MAP" 2>/dev/null | cut -d' ' -f1); fi
      printf '%s' "$u"
      ;;
    *) printf '%s' "$1" ;;
  esac
}

name_of() {
  [ -f "$MAP" ] || map_refresh
  n=$(grep -m1 "^$1 " "$MAP" 2>/dev/null | cut -d' ' -f2)
  if [ -n "$n" ]; then printf '%s' "$n"; else printf 'uid %s' "$1"; fi
}

# raw little-endian u32 on stdout (works with mksh/toybox printf)
emit_u32() {
  v=$1
  printf "\\$(printf '%03o' $((v & 255)))\\$(printf '%03o' $(((v >> 8) & 255)))\\$(printf '%03o' $(((v >> 16) & 255)))\\$(printf '%03o' $(((v >> 24) & 255)))"
}

policy_count() {
  [ -f "$BIN" ] || { echo 0; return; }
  b=$(wc -c < "$BIN" 2>/dev/null | tr -d ' ')
  echo $((b / 4))
}

build_bin() {
  need_store
  : > "$BIN.tmp" || die "cannot write $BIN.tmp"
  count=0
  while IFS= read -r line; do
    ent=$(printf '%s' "$line" | sed 's/#.*//; s/[[:space:]]//g')
    [ -n "$ent" ] || continue
    u=$(uid_of "$ent")
    if [ -z "$u" ]; then echo "glm: unknown package '$ent' (skipped)" >&2; continue; fi
    emit_u32 "$u" >> "$BIN.tmp" || die "emit failed"
    count=$((count + 1))
  done < "$CONF"
  mv "$BIN.tmp" "$BIN" || die "cannot install $BIN"
  chmod 644 "$BIN" 2>/dev/null
  echo "policy: $count entr$( [ "$count" = 1 ] && echo y || echo ies )"
}

apply() {
  mode=${1:-sync}
  mp=$(cat /proc/sys/kernel/modprobe 2>/dev/null)
  case "$mp" in
    *gl_fix.sh) ;;
    *) die "root helper is not armed (modprobe=$mp); run glroot.sh first" ;;
  esac
  # The helper runs as root and must read these from /data. /data is fscrypt:
  # root without the file key gets ENOKEY on a cold open, but serves from the
  # page cache. So read them here as uid 2000 first (the "warm" step).
  for f in "$D/asuid" "$D/sud_policy" "$D/sud" "$D/keylink" "$D/runroot.sh" \
           "$D/busybox" "$D/rw.list" "$D/pwn2" "$D/gl_fix.sh" \
           "$M/policy.bin" "$M/policy.conf"; do
    cat "$f" >/dev/null 2>&1
  done
  [ -d "$D/rwstore" ] && find "$D/rwstore" -type f -exec cat {} + >/dev/null 2>&1
  tok="$(date +%s 2>/dev/null)-$$"
  # Reuse the existing inode: root cannot open a freshly created /data inode
  # (fscrypt). Truncate in place, write, then warm the page cache.
  [ -f "$REQ" ] || : > "$REQ" 2>/dev/null
  : > "$REQ" 2>/dev/null
  { printf 'cmd=%s\ntoken=%s\n' "$mode" "$tok"; if [ -n "$EXTRA" ]; then printf '%s\n' "$EXTRA"; fi; } > "$REQ" || die "cannot write $REQ"
  cat "$REQ" >/dev/null 2>&1
  chmod 644 "$REQ" 2>/dev/null
  "$PWN" >/dev/null 2>&1
  i=0
  while [ $i -lt 80 ]; do
    if grep -q "token=$tok" "$ST" 2>/dev/null; then
      sed 's/^/  /' "$ST"
      return 0
    fi
    sleep 0.25
    i=$((i + 1))
  done
  echo "glm: helper did not answer within 20s" >&2
  return 1
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

# ---- read/write bind layer ------------------------------------------------
# The live layer lives in a tmpfs (root can always write there). A copy is
# mirrored to /data by this process (uid 2000, which holds the fscrypt key).
rw_id() { printf '%s' "$1" | sed 's#^/*##; s#[/.]#_#g'; }

rw_copy_up() { # $1 = path
  p=${1%/}
  [ -e "$p" ] || return 1
  id=$(rw_id "$p")
  dst="$D/rwstore/$id"
  mkdir -p "$D/rwstore" 2>/dev/null
  if [ -d "$p" ]; then
    if [ -d "$dst" ] && [ -n "$(ls -A "$dst" 2>/dev/null)" ]; then return 0; fi
    rm -rf "$dst" 2>/dev/null
    mkdir -p "$dst" 2>/dev/null || return 1
    if [ -r "$p" ] && [ -x "$p" ]; then
      cp -a "$p/." "$dst/" 2>/dev/null || echo "rw: copy-up had errors (unreadable files skipped)" >&2
    else
      # root-only tree: stream it through su into the uid-2000 store
      /odm/bin/su -c "tar -cf - -C '$p' ." 2>/dev/null | tar -xf - -C "$dst" 2>/dev/null \
        || { echo "rw: root copy-up failed for $p" >&2; return 1; }
    fi
  elif [ -f "$p" ]; then
    [ -f "$dst" ] && return 0
    if [ -r "$p" ]; then
      cp -p "$p" "$dst" 2>/dev/null || return 1
    else
      /odm/bin/su -c "cat '$p'" > "$dst" 2>/dev/null || return 1
      chmod 644 "$dst" 2>/dev/null
    fi
  else
    echo "rw: $p is not a file or directory" >&2
    return 1
  fi
  return 0
}

rw_save_all() {
  [ -d "$D/rw" ] || { echo "rw: no live layer mounted"; return 0; }
  [ -f "$D/rw.list" ] || return 0
  n=0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    id=$(rw_id "$p")
    src="$D/rw/$id"
    dst="$D/rwstore/$id"
    mkdir -p "$D/rwstore" 2>/dev/null
    if [ -d "$src" ]; then
      rm -rf "$dst" 2>/dev/null
      mkdir -p "$dst" 2>/dev/null
      if [ -r "$src" ] && [ -x "$src" ]; then
        cp -a "$src/." "$dst/" 2>/dev/null && n=$((n + 1))
      else
        /odm/bin/su -c "tar -cf - -C '$src' ." 2>/dev/null | tar -xf - -C "$dst" 2>/dev/null \
          && n=$((n + 1))
      fi
    elif [ -f "$src" ]; then
      if [ -r "$src" ]; then
        cp -f "$src" "$dst" 2>/dev/null && n=$((n + 1))
      else
        /odm/bin/su -c "cat '$src'" > "$dst" 2>/dev/null && n=$((n + 1))
      fi
    fi
  done < "$D/rw.list"
  echo "rw: saved $n path(s) to $D/rwstore"
}

# Management commands mutate the uid-2000 store: delegate them from apps.
MYU=$(id -u 2>/dev/null)

# First run inside Termux: install the boot hook and the PATH symlink. Only the
# Termux uid holds the credential-encrypted (CE) keyring, so this cannot be done
# from root or from adb.
case "$HOME" in
  */com.termux/files/home)
    if [ "$MYU" != "2000" ] && [ "$MYU" != "0" ]; then
      B="$HOME/.termux/boot"
      if [ ! -f "$B/00-root.sh" ] && [ -f "$D/00-root.sh" ]; then
        mkdir -p "$B" 2>/dev/null && cp "$D/00-root.sh" "$B/00-root.sh" 2>/dev/null \
          && chmod 700 "$B/00-root.sh" 2>/dev/null \
          && echo "glm: installed boot hook $B/00-root.sh"
      fi
      if [ -n "${PREFIX:-}" ] && [ -d "$PREFIX/bin" ] && [ ! -e "$PREFIX/bin/glm" ]; then
        ln -sf "$M/glm" "$PREFIX/bin/glm" 2>/dev/null && echo "glm: linked $PREFIX/bin/glm"
      fi
    fi
    ;;
esac

if [ "$MYU" != "2000" ] && [ "$MYU" != "0" ]; then
  case "$cmd" in
    status|list|allow|deny|mode|log|pending|sync|apply|restart|rw)
      proxy "$cmd" "$@"
      ;;
  esac
fi

case "$cmd" in
  status)
    echo "GhostLock Root Manager $VERSION"
    echo "  model : $(getprop ro.product.model 2>/dev/null) / Android $(getprop ro.build.version.release 2>/dev/null)"
    echo "  selinux: $(getenforce 2>/dev/null)"
    if [ -f "$ST" ]; then
      sed 's/^/  helper: /' "$ST"
    else
      echo "  helper: (no status yet)"
    fi
    if [ -f /odm/ghostlock/policy.bin ]; then
      echo "  mode  : enforce ($(policy_count) uid(s) allowed, 0 and 2000 implicit)"
    else
      echo "  mode  : permissive (no policy file)"
    fi
    if [ -f "$ALOG" ]; then
      b=$(wc -c < "$ALOG" 2>/dev/null | tr -d ' ')
      echo "  log   : $((b / 8)) record(s)"
    fi
    rwn=0
    [ -f "$D/rw.list" ] && rwn=$(wc -l < "$D/rw.list" 2>/dev/null | tr -d ' ')
    echo "  rw    : ${rwn:-0} path(s) in the bind layer"
    if [ -x /odm/bin/busybox ]; then
      echo "  busybox: /odm/bin/busybox ($(/odm/bin/busybox 2>/dev/null | head -1))"
    else
      echo "  busybox: not installed"
    fi
    echo "  store : $M"
    echo "  su    : $(command -v su 2>/dev/null || echo none)"
    ;;

  list)
    if [ ! -f /odm/ghostlock/policy.bin ]; then
      echo "mode: permissive (every uid allowed)"
    elif [ ! -s /odm/ghostlock/policy.bin ]; then
      echo "mode: enforce (no extra uids; root and shell only)"
    else
      echo "mode: enforce"
      od -An -tu4 -w4 /odm/ghostlock/policy.bin 2>/dev/null | while read -r u; do
        [ -n "$u" ] || continue
        # prefer the name the user actually added to policy.conf
        nm=""
        if [ -f "$CONF" ]; then
          while IFS= read -r line; do
            ent=$(printf '%s' "$line" | sed 's/#.*//; s/[[:space:]]//g')
            [ -n "$ent" ] || continue
            [ "$(uid_of "$ent")" = "$u" ] && { nm="$ent"; break; }
          done < "$CONF"
        fi
        [ -n "$nm" ] || nm=$(name_of "$u")
        printf '  %-6s %s\n' "$u" "$nm"
      done
    fi
    ;;

  allow)
    [ $# -gt 0 ] || die "usage: glm allow <package|uid> ..."
    need_store
    for e in "$@"; do
      u=$(uid_of "$e")
      [ -n "$u" ] || die "unknown package/uid: $e"
      if grep -qx "$e" "$CONF" 2>/dev/null; then
        echo "already allowed: $e"
      else
        printf '%s\n' "$e" >> "$CONF"
        echo "added: $e (uid $u)"
      fi
    done
    build_bin
    apply sync
    ;;

  deny)
    [ $# -gt 0 ] || die "usage: glm deny <package|uid> ..."
    need_store
    for e in "$@"; do
      u=$(uid_of "$e")
      grep -vx "$e" "$CONF" > "$CONF.tmp" 2>/dev/null
      mv "$CONF.tmp" "$CONF" 2>/dev/null
      if [ -n "$u" ]; then
        grep -vE "^[[:space:]]*$u[[:space:]]*$" "$CONF" > "$CONF.tmp" 2>/dev/null
        mv "$CONF.tmp" "$CONF" 2>/dev/null
      fi
      echo "removed: $e${u:+ (uid $u)}"
    done
    build_bin
    apply sync
    ;;

  mode)
    case "${1:-show}" in
      enforce)
        need_store
        [ -f "$BIN" ] || : > "$BIN"
        build_bin
        apply sync
        echo "mode: enforce"
        ;;
      permissive)
        rm -f "$BIN" 2>/dev/null
        apply sync
        echo "mode: permissive"
        ;;
      *)
        if [ -f /odm/ghostlock/policy.bin ]; then echo "mode: enforce"; else echo "mode: permissive"; fi
        ;;
    esac
    ;;

  log)
    n=${1:-20}
    [ -f "$ALOG" ] || die "no log yet ($ALOG)"
    b=$(wc -c < "$ALOG" 2>/dev/null | tr -d ' ')
    total=$((b / 8))
    skip=$((total - n))
    [ "$skip" -lt 0 ] && skip=0
    echo "records: $total (last $((total - skip)))"
    tail -c +$((skip * 8 + 1)) "$ALOG" 2>/dev/null | od -An -v -tu4 -w8 | while read -r u v; do
      [ -n "$u" ] || continue
      if [ "$v" = 1 ]; then s=ALLOW; else s=DENY; fi
      printf '  %-6s %-5s %s\n' "$u" "$s" "$(name_of "$u")"
    done
    ;;

  pending)
    [ -f "$ALOG" ] || { echo "no log yet"; exit 0; }
    echo "denied uids (count uid package):"
    od -An -v -tu4 -w8 "$ALOG" 2>/dev/null | while read -r u v; do
      [ "$v" = 0 ] && echo "$u"
    done | sort -n | uniq -c | while read -r c u; do
      printf '  %-4s %-6s %s\n' "$c" "$u" "$(name_of "$u")"
    done
    ;;

  sync)
    map_refresh
    echo "packages: $(wc -l < "$MAP" 2>/dev/null | tr -d ' ')"
    ;;

  apply)
    rw_save_all 2>/dev/null
    build_bin
    apply sync
    ;;

  restart)
    echo "restarting daemon (clears leaked zombies)"
    build_bin
    apply restart
    ;;

  su)
    exec "$SU" "$@"
    ;;

  boot)
    case "$HOME" in
      */com.termux/files/home) B="$HOME/.termux/boot/00-root.sh"; IN_TERMUX=1 ;;
      *) B=/data/data/com.termux/files/home/.termux/boot/00-root.sh; IN_TERMUX=0 ;;
    esac
    if [ "$IN_TERMUX" = "1" ] && [ ! -f "$B" ] && [ -f "$D/00-root.sh" ]; then
      mkdir -p "$(dirname "$B")" 2>/dev/null \
        && cp "$D/00-root.sh" "$B" 2>/dev/null \
        && chmod 700 "$B" 2>/dev/null \
        && echo "glm: installed boot hook $B"
    fi
    echo "Termux:Boot hook : $B"
    if [ -f "$B" ]; then
      echo "  status         : installed ($(wc -c < "$B" 2>/dev/null | tr -d ' ') bytes)"
      grep -n 'glroot.sh --' "$B" 2>/dev/null | sed 's/^/  chain          : /'
    elif [ "$IN_TERMUX" = "1" ]; then
      echo "  status         : MISSING -- run 'glm boot' inside Termux to install"
    else
      echo "  status         : not readable from uid $(id -u) (CE home); check 'glm boot' in Termux"
    fi
    echo "  arming script  : /data/local/tmp/glroot.sh --boot"
    echo "  helper         : $(cat /proc/sys/kernel/modprobe 2>/dev/null)"
    echo "  adb tcp        : persist.adb.tcp.port=$(getprop persist.adb.tcp.port)"
    ;;

  shell|sh)
    exec "$SU"
    ;;

  bb|busybox)
    [ -x /odm/bin/busybox ] || die "busybox is not installed yet; run 'glm apply'"
    exec /odm/bin/busybox "$@"
    ;;

  rw)
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    case "$sub" in
      list|status)
        EXTRA="op=list"
        apply rw >/dev/null 2>&1
        cat /odm/ghostlock/rw.last 2>/dev/null
        ;;
      save|commit)
        rw_save_all
        ;;
      add)
        [ $# -gt 0 ] || die "usage: glm rw add <path>"
        P="${1%/}"
        case "$P" in /*) ;; *) die "need an absolute path" ;; esac
        [ -e "$P" ] || die "no such path: $P"
        rw_copy_up "$P" || die "copy-up failed for $P"
        grep -qxF "$P" "$D/rw.list" 2>/dev/null || printf '%s\n' "$P" >> "$D/rw.list"
        EXTRA="op=add
path=$P"
        apply rw
        echo "--- rw ---"
        cat /odm/ghostlock/rw.last 2>/dev/null
        ;;
      rm|remove|del)
        [ $# -gt 0 ] || die "usage: glm rw rm <path> [--purge]"
        P=""; PURGE=0
        for a in "$@"; do
          case "$a" in
            --purge|-p) PURGE=1 ;;
            *) P="${a%/}" ;;
          esac
        done
        [ -n "$P" ] || die "usage: glm rw rm <path> [--purge]"
        rw_save_all
        if [ -f "$D/rw.list" ]; then
          grep -vxF "$P" "$D/rw.list" > "$D/rw.list.tmp" 2>/dev/null
          mv "$D/rw.list.tmp" "$D/rw.list" 2>/dev/null
        fi
        EXTRA="op=rm
path=$P"
        apply rw
        [ "$PURGE" = 1 ] && rm -rf "$D/rwstore/$(rw_id "$P")" 2>/dev/null
        echo "--- rw ---"
        cat /odm/ghostlock/rw.last 2>/dev/null
        ;;
      preset)
        for P in /system/etc /vendor/etc /product/etc; do
          [ -d "$P" ] || continue
          rw_copy_up "$P" >/dev/null 2>&1
          grep -qxF "$P" "$D/rw.list" 2>/dev/null || printf '%s\n' "$P" >> "$D/rw.list"
          EXTRA="op=add
path=$P"
          apply rw >/dev/null 2>&1
          echo "  $P"
        done
        echo "--- rw ---"
        cat /odm/ghostlock/rw.last 2>/dev/null
        ;;
      *)
        die "usage: glm rw [list|add <path>|rm <path> [--purge]|save|preset]"
        ;;
    esac
    ;;

  test)
    if grep -q gl_fix.sh /proc/sys/kernel/modprobe 2>/dev/null; then
      EXTRA=""
      apply test >/dev/null 2>&1
      echo "uids that requested root (policy test):"
      cat /odm/ghostlock/test.out 2>/dev/null
      echo "client : $SU"
    else
      echo "client : $SU"
      "$SU" -c 'echo "  uid=$(id -u) ctx=$(cat /proc/self/attr/current 2>/dev/null)"' 2>&1
    fi
    ;;

  help|-h|--help)
    cat <<EOF
glm $VERSION -- GhostLock Root Manager

  glm status              show root/daemon/policy/log state
  glm list                list allowed uids (with package names)
  glm allow <pkg|uid>...  allow an app (e.g. glm allow com.termux)
  glm deny  <pkg|uid>...  revoke access
  glm mode [enforce|permissive]
  glm log [n]             show the last n access decisions
  glm pending             uids that were denied (candidates to allow)
  glm sync                refresh the uid -> package map
  glm apply               rebuild policy and push it to the root helper
  glm restart             restart the su daemon (clears leaked zombies)
  glm test                run a root self-test
  glm boot                show/install the Termux:Boot hook (run in Termux)
  glm su <cmd...>         run a command as root
  glm shell               interactive root shell
  glm bb <applet...>      run BusyBox (e.g. glm bb wget --help)
  glm rw list             show the read/write bind layer
  glm rw add <path>       make a file/dir read-write (persistent copy)
  glm rw rm  <path>       detach it (--purge also deletes the copy)
  glm rw save             persist current tmpfs changes to /data
  glm rw preset           add /system/etc /vendor/etc /product/etc

  Read/write note: this kernel has no overlayfs. Each path in the layer is
  copied to a tmpfs (writable by root) and bind-mounted over the original; a
  mirrored copy under /data survives reboot. `glm rw save` (also run by
  `glm apply` and `glm rw rm`) flushes tmpfs changes back to /data.

  Enforcement note: checks run inside the su client. Hiding the unpatched
  binary raises the bar, but a hand-written client that speaks the daemon
  protocol could bypass it (daemon-side checks are the next step).
EOF
    ;;

  version)
    echo "glm $VERSION"
    ;;

  *)
    die "unknown command '$cmd' (try: glm help)"
    ;;
esac
