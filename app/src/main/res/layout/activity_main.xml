<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_header"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/section" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="checking…" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnRefresh"
                style="@style/RowButton"
                android:text="Refresh" />
            <Button
                android:id="@+id/btnArm"
                style="@style/RowButton"
                android:text="Arm root help" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnDeploy"
                style="@style/RowButton"
                android:text="Deploy kit" />
            <Button
                android:id="@+id/btnInstallSu"
                style="@style/RowButton"
                android:text="Install su" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnStartDaemon"
                style="@style/RowButton"
                android:text="Start daemon" />
            <Button
                android:id="@+id/btnStopDaemon"
                style="@style/RowButton"
                android:text="Stop daemon" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="RUN AS ROOT" />

        <EditText
            android:id="@+id/cmd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cmd_hint"
            android:inputType="text"
            android:maxLines="3"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnRun"
                style="@style/RowButton"
                android:text="Run" />
            <Button
                android:id="@+id/btnWhoami"
                style="@style/RowButton"
                android:text="id" />
            <Button
                android:id="@+id/btnExecTest"
                style="@style/RowButton"
                android:text="Exec test" />
            <Button
                android:id="@+id/btnClear"
                style="@style/RowButton"
                android:text="Clear log" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="SU POLICY (minisud)" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnMode"
                style="@style/RowButton"
                android:text="Mode: ?" />
            <Button
                android:id="@+id/btnAllowSelf"
                style="@style/RowButton"
                android:text="Allow this app" />
        </LinearLayout>

        <EditText
            android:id="@+id/policyEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/policy_hint"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnAllow"
                style="@style/RowButton"
                android:text="Allow" />
            <Button
                android:id="@+id/btnDeny"
                style="@style/RowButton"
                android:text="Deny" />
            <Button
                android:id="@+id/btnPolicyList"
                style="@style/RowButton"
                android:text="Show" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="RW LAYER (tmpfs)" />

        <EditText
            android:id="@+id/rwPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rw_hint"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnRwAdd"
                style="@style/RowButton"
                android:text="Add" />
            <Button
                android:id="@+id/btnRwList"
                style="@style/RowButton"
                android:text="List" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnRwSave"
                style="@style/RowButton"
                android:text="Save" />
            <Button
                android:id="@+id/btnRwRemove"
                style="@style/RowButton"
                android:text="Remove" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="BOOT / START LOG" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnBootDir"
                style="@style/RowButton"
                android:text="Boot dir" />
            <Button
                android:id="@+id/btnBootRun"
                style="@style/RowButton"
                android:text="Run boot" />
            <Button
                android:id="@+id/btnBootLog"
                style="@style/RowButton"
                android:text="Start log" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="SHIZUKU" />

        <LinearLayout style="@style/Row">
            <Button
                android:id="@+id/btnShizuku"
                style="@style/RowButton"
                android:text="Shizuku status" />
            <Button
                android:id="@+id/btnShizukuApp"
                style="@style/RowButton"
                android:text="Open Shizuku" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="OUTPUT" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/log"
                style="@style/Console"
                android:text="" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
